{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "A whole-number tag like 2 needs --set-string, or Helm turns it into a number."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "clusterName": {
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "A list: --set 'namespaces={payments,data}'."
    },
    "nodes": {
      "type": "object",
      "properties": {
        "observe": {
          "type": "boolean"
        }
      }
    },
    "watch": {
      "type": "object",
      "properties": {
        "configMaps": {
          "type": "boolean"
        },
        "secretMetadata": {
          "type": "boolean",
          "description": "Grants list and watch on Secrets; OpsTide requests their metadata only."
        }
      }
    },
    "releases": {
      "type": "object",
      "properties": {
        "observationMinutes": {
          "enum": [
            5,
            10,
            15,
            30
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1000,
          "description": "A whole number of at least 1000 (write 10000000, not 1e7)."
        }
      }
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "extraEgress": {
          "type": "array"
        },
        "apiServer": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "publicURL": {
      "type": "string",
      "pattern": "^(https?://[^\\s/?#]+(/[^\\s?#]*)?)?$"
    },
    "clustrail": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^((https?://[^\\s/?#{}]+([/?#][^\\s]*)?)|(clustrail://[^\\s]*))?$"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "description": "A Secret in the release namespace with the token under the key \"token\"."
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "scrapeTimeout": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "selector": {
          "type": "string",
          "pattern": "^[^{}]*$"
        },
        "disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OpsTideDown",
              "OpsTideNotReady",
              "OpsTideStuck",
              "OpsTideWatchesFailing",
              "OpsTideDroppedRecords",
              "OpsTideVolumeFilling"
            ]
          }
        },
        "volumeFreeRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "windows": {
          "type": "array",
          "maxItems": 100,
          "description": "Planned work. Each: name, and start+end (RFC 3339) or cron (5 fields)+duration (90m, 2h) with an optional timeZone; optional namespaces (empty: the whole cluster) and note. OpsTide validates them strictly at start and refuses to start on a bad one.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "cron": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "namespaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 50
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "morningSummary": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "string",
              "minLength": 9
            },
            "timeZone": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "string",
              "enum": [
                "since-18h",
                "12h",
                "24h"
              ]
            },
            "language": {
              "type": "string",
              "enum": [
                "en",
                "tr"
              ]
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "failures",
                  "troubles",
                  "gaps",
                  "due",
                  "changes"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "destinations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "type",
              "name",
              "urlFrom"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "slack",
                  "teams",
                  "webhook"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "urlFrom": {
                "type": "object",
                "required": [
                  "secret",
                  "key"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[-._a-zA-Z0-9]{1,253}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "allowEgress443": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
